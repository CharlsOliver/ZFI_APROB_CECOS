<mvc:View controllerName="aprobacioncecos.controller.Master"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page 
        id="masterPage" 
        title="Solicitudes">
        <headerContent>
            <Button 
                icon="sap-icon://refresh"
                press="onLoadSolicitudes"
                tooltip="Recargar lista"/>
        </headerContent>
        <content>
            <List
                id="centrosList"
                mode="SingleSelectMaster"
                noDataText="No hay registros"
                growing="true"
                growingThreshold="10"
                itemPress="onItemPress"
                items="{Solicitudes>/}">
                <items>
                    <ObjectListItem
                        type="Active"
                        title="{Solicitudes>Id}">
                        <firstStatus>
                            <ObjectStatus
                                text="{
                                    path: 'Solicitudes>Fecha', 
                                    formatter: '.formatter.formatDateShort'
                                }"/>
                        </firstStatus>
                        <attributes>
                            <ObjectAttribute text="{Solicitudes>Nombre}"/>
                            <ObjectAttribute text="{Solicitudes>Desc_flow}"/>
                            <ObjectAttribute text="{Solicitudes>Desc_proc}"/>
                        </attributes>
                    </ObjectListItem>
                </items>
            </List>
        </content>
    </Page>
</mvc:View>
